# Polaris ALSA sink + source (output MM3 hw:0,2 / input MM2 hw:0,1)
load-module module-alsa-sink device=hw:0,2 sink_name=polaris_spk rate=48000
set-default-sink polaris_spk
set-sink-volume polaris_spk 100%
set-sink-mute polaris_spk 0
load-module module-alsa-source device=hw:0,1 source_name=polaris_mic rate=48000
set-default-source polaris_mic
set-source-volume polaris_mic 100%
