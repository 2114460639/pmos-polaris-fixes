diff --git a/device/testing/firmware-xiaomi-polaris/Polaris-HiFi.conf b/device/testing/firmware-xiaomi-polaris/Polaris-HiFi.conf
new file mode 100644
index 0000000000..a003ac68cb
--- /dev/null
+++ b/device/testing/firmware-xiaomi-polaris/Polaris-HiFi.conf
@@ -0,0 +1,56 @@
+# UCM for Xiaomi Mi MIX 2S (polaris)
+#
+# Speaker: TAS2559 amp driven from QUAT_MI2S_RX; playback frontend is
+#   MultiMedia3 (hw:0,2).  MultiMedia1 is deliberately avoided: its q6afe
+#   frontend needs a re-init dance on this ADSP (same reason alsa-ucm-conf
+#   ships HiFi-MM1.conf as an MM3 variant for DB845c-class boards).
+# Mic: AMIC -> DEC -> AIF1_CAP -> SLIMBUS_0_TX -> MultiMedia2 (hw:0,1).
+#
+# Note: the mic gain controls must be written as 'ADC1 Volume' /
+#   'ADC2 Volume' here.  Writing them as bare 'ADC1' / 'ADC2' fails with
+#   ENOENT inside a UCM sequence (verified against this kernel), while
+#   amixer resolves the short name.  'ADC1 Volume' verifiably hits the
+#   same control (set 5 -> UCM -> 20 round-trip checked on-device).
+
+SectionVerb {
+        EnableSequence [
+                cset "name='QUAT_MI2S_RX Audio Mixer MultiMedia3' 1"
+                cset "name='MultiMedia2 Mixer SLIMBUS_0_TX' 1"
+                cset "name='ADC MUX0' AMIC"
+                cset "name='ADC MUX1' AMIC"
+                cset "name='CDC_IF TX0 MUX' DEC0"
+                cset "name='CDC_IF TX1 MUX' DEC1"
+                cset "name='AIF1_CAP Mixer SLIM TX0' 1"
+                cset "name='AMIC MUX0' ADC1"
+                cset "name='AMIC MUX1' ADC2"
+                cset "name='ADC1 Volume' 20"
+                cset "name='ADC2 Volume' 20"
+        ]
+
+        DisableSequence [
+                cset "name='QUAT_MI2S_RX Audio Mixer MultiMedia3' 0"
+                cset "name='MultiMedia2 Mixer SLIMBUS_0_TX' 0"
+        ]
+
+        Value {
+                TQ "HiFi"
+        }
+}
+
+SectionDevice."Speaker" {
+        Comment "Loud speaker"
+
+        Value {
+                PlaybackPriority 100
+                PlaybackPCM "hw:${CardId},2"
+        }
+}
+
+SectionDevice."Mic" {
+        Comment "Built-in microphone"
+
+        Value {
+                CapturePriority 100
+                CapturePCM "hw:${CardId},1"
+        }
+}
