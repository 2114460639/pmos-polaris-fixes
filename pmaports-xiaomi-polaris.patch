diff --git a/device/community/linux-postmarketos-qcom-sdm845/nt35596s-prepare-prev-first.patch b/device/community/linux-postmarketos-qcom-sdm845/nt35596s-prepare-prev-first.patch
new file mode 100644
index 00000000..40f57439
--- /dev/null
+++ b/device/community/linux-postmarketos-qcom-sdm845/nt35596s-prepare-prev-first.patch
@@ -0,0 +1,14 @@
+Panel nt35596s sends its init commands from prepare(), which the panel bridge
+runs in the pre_enable chain. Without prepare_prev_first the panel bridge is
+pre_enabled before the MSM DSI host is powered on, so every DCS write fails
+with -EINVAL and the panel stays black.
+
+--- a/drivers/gpu/drm/panel/panel-novatek-nt35596s.c
++++ b/drivers/gpu/drm/panel/panel-novatek-nt35596s.c
+@@ -476,6 +476,7 @@ static int nt35596s_panel_add(struct nt35596s_panel *pinfo)
+ 					     "failed to get reset gpio from DT\n");
+ 
+ 	drm_panel_init(&pinfo->base, dev, &panel_funcs, DRM_MODE_CONNECTOR_DSI);
++	pinfo->base.prepare_prev_first = true;
+ 
+ 	drm_panel_add(&pinfo->base);
