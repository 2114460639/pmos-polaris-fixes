diff --git a/device/testing/device-xiaomi-polaris/polaris-crash-sysctl.conf b/device/testing/device-xiaomi-polaris/polaris-crash-sysctl.conf
new file mode 100644
index 0000000000..b89baae43d
--- /dev/null
+++ b/device/testing/device-xiaomi-polaris/polaris-crash-sysctl.conf
@@ -0,0 +1,15 @@
+# Hang auto-recovery for xiaomi-polaris (forensics hardening).
+#
+# The device hung once from RCU kthread starvation (CPU saturated, network /
+# sshd / adbd all unresponsive).  The RCU stall detector still ran from timer
+# context and printed the trace we used for diagnosis, so turning the stall
+# into a panic gives us: stall -> panic -> systemd stops feeding the hardware
+# watchdog -> SoC resets within ~10s (RuntimeWatchdogSec), no manual long
+# press needed.  Persistent journal keeps everything logged before the stall.
+#
+# NOTE: softlockup_panic / hung_task_panic are unavailable on this kernel
+# (CONFIG_SOFTLOCKUP_DETECTOR / CONFIG_DETECT_HUNG_TASK are not set); the
+# hardware watchdog below covers those hang classes anyway.
+kernel.panic = 120
+kernel.panic_on_rcu_stall = 1
+kernel.panic_on_oops = 1
diff --git a/device/testing/device-xiaomi-polaris/polaris-watchdog.conf b/device/testing/device-xiaomi-polaris/polaris-watchdog.conf
new file mode 100644
index 0000000000..4272105271
--- /dev/null
+++ b/device/testing/device-xiaomi-polaris/polaris-watchdog.conf
@@ -0,0 +1,7 @@
+# Let PID 1 own the hardware watchdog (/dev/watchdog): systemd feeds it every
+# half of RuntimeWatchdogSec.  If the kernel stalls (RCU/oops panic) or
+# userspace incl. PID 1 stops making progress, feeding stops and the SoC
+# hard-resets itself -- the last-resort recovery for hangs that never reach
+# the panic path.  10s timeout is comfortably above normal load spikes.
+[Manager]
+RuntimeWatchdogSec=10
