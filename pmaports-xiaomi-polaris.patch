diff --git a/device/testing/adbd-polaris/APKBUILD b/device/testing/adbd-polaris/APKBUILD
new file mode 100644
index 0000000000..70897b042b
--- /dev/null
+++ b/device/testing/adbd-polaris/APKBUILD
@@ -0,0 +1,57 @@
+# Prebuilt aarch64 static adbd for xiaomi-polaris: ADB device mode over the
+# gadget's functionfs function, coexisting with the NCM USB network (ssh over
+# 172.16.42.1 keeps working). The binary is cross-compiled on the host with
+# pmos-polaris-fixes/polaris-adbd-build.sh (tonyho/adbd-linux + OpenSSL 3
+# static, ADB_NON_ANDROID so no Android property/init dependency).
+maintainer="Molly Sophia <mollysophia379@gmail.com>"
+pkgname=adbd-polaris
+pkgdesc="ADB daemon (adbd) over USB functionfs, prebuilt static aarch64"
+pkgver=1
+pkgrel=3
+url="https://github.com/tonyho/adbd-linux"
+license="Apache-2.0"
+arch="aarch64"
+# !strip: the binary is prebuilt and already stripped on the host; running the
+# cross strip again in chroot buys nothing and risks toolchain mismatch.
+options="!check !archcheck !strip !tracedeps"
+depends="systemd"
+source="
+	adbd
+	polaris-adbd-setup.sh
+	polaris-adbd.service
+	polaris-adbd.preset
+"
+
+build() {
+	# Prebuilt binary, nothing to build.
+	:
+}
+
+package() {
+	install -Dm755 "$srcdir"/adbd "$pkgdir"/usr/bin/adbd
+
+	# Sets up ffs.adb on the existing g1 gadget (short unbind window), starts
+	# adbd and keeps both adbd and the UDC binding alive. Runs from a system
+	# unit so an SSH disconnect can never take it down (see the script header).
+	install -Dm755 "$srcdir"/polaris-adbd-setup.sh \
+		"$pkgdir"/usr/sbin/polaris-adbd-setup
+	install -Dm644 "$srcdir"/polaris-adbd.service \
+		"$pkgdir"/usr/lib/systemd/system/polaris-adbd.service
+	# Preset rule: presets only run against newly installed units, and the
+	# stock 99-default.preset ("disable *") strips the wants symlink on first
+	# install otherwise. Same trick as firmware-xiaomi-polaris/50-polaris.preset.
+	install -Dm644 "$srcdir"/polaris-adbd.preset \
+		"$pkgdir"/usr/lib/systemd/system-preset/55-adbd-polaris.preset
+	# Ship the enable symlink ourselves: preset files get their symlinks wiped
+	# on package upgrade, this does not.
+	install -d "$pkgdir"/etc/systemd/system/multi-user.target.wants
+	ln -sf /usr/lib/systemd/system/polaris-adbd.service \
+		"$pkgdir"/etc/systemd/system/multi-user.target.wants/polaris-adbd.service
+}
+
+sha512sums="
+b72ea2dadb2625b1adc67fb32bceb9367dfe561f3831f5ff37b5020aeaae74cbfc6739b5515206a486b62f12547f67f2c4dd64819c7846ce9114ef2a18d5d58f  adbd
+29aec90846bae9d017de3aaca5101d9997053a2a3fb67ae411c1b44a05249386560af72e384fc8135e654650e7f2496534c60e2442046385aa64dc754bc59c23  polaris-adbd-setup.sh
+188001d6bc386d4c20693dbc50f3bb7501cb783f11d3ff0375fdc32038ee9a53c66e581654fc27b9077d9ba9ac41bc28f75c641421d170cf42003bce928b8db6  polaris-adbd.service
+b042a8cc61085a24bd6cdcd35fa0e28a170904896a9312f8e58a48948d37fc2e50031f9d2cd0ba164895ca91addb247ae75e5ac93f57febcbe48188358d81b8d  polaris-adbd.preset
+"
