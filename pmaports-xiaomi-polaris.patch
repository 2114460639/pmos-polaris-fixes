diff --git a/device/testing/firmware-xiaomi-polaris/polaris-mic-routing.service b/device/testing/firmware-xiaomi-polaris/polaris-mic-routing.service
new file mode 100644
index 0000000000..acb061d0bd
--- /dev/null
+++ b/device/testing/firmware-xiaomi-polaris/polaris-mic-routing.service
@@ -0,0 +1,9 @@
+[Unit]
+Description=Polaris mic routing keeper (AMIC -> ADC -> DEC -> AIF1_CAP -> SLIM TX0 -> MM1+MM2)
+After=sound.target
+[Service]
+Type=simple
+ExecStart=/bin/sh -c 'for i in $(seq 1 100); do [ -e /dev/snd/controlC0 ] && break; sleep 0.2; done; while true; do amixer -c 0 sset "MultiMedia1 Mixer SLIMBUS_0_TX" on; amixer -c 0 sset "MultiMedia2 Mixer SLIMBUS_0_TX" on; amixer -c 0 sset "ADC MUX0" "AMIC"; amixer -c 0 sset "ADC MUX1" "AMIC"; amixer -c 0 sset "CDC_IF TX0 MUX" "DEC0"; amixer -c 0 sset "CDC_IF TX1 MUX" "DEC1"; amixer -c 0 sset "AIF1_CAP Mixer SLIM TX0" on; amixer -c 0 sset "AMIC MUX0" "ADC1"; amixer -c 0 sset "AMIC MUX1" "ADC2"; amixer -c 0 sset "ADC1" 20; amixer -c 0 sset "ADC2" 20; sleep 10; done'
+Restart=always
+[Install]
+WantedBy=multi-user.target
diff --git a/device/testing/firmware-xiaomi-polaris/polaris-pulse-default.pa b/device/testing/firmware-xiaomi-polaris/polaris-pulse-default.pa
new file mode 100644
index 0000000000..9fc99191f1
--- /dev/null
+++ b/device/testing/firmware-xiaomi-polaris/polaris-pulse-default.pa
@@ -0,0 +1,8 @@
+# Polaris ALSA sink + source (output MM3 hw:0,2 / input MM2 hw:0,1)
+load-module module-alsa-sink device=hw:0,2 sink_name=polaris_spk rate=48000
+set-default-sink polaris_spk
+set-sink-volume polaris_spk 100%
+set-sink-mute polaris_spk 0
+load-module module-alsa-source device=hw:0,1 source_name=polaris_mic rate=48000
+set-default-source polaris_mic
+set-source-volume polaris_mic 100%
diff --git a/device/testing/firmware-xiaomi-polaris/polaris-pulse-setup.service b/device/testing/firmware-xiaomi-polaris/polaris-pulse-setup.service
new file mode 100644
index 0000000000..0fab8a7d87
--- /dev/null
+++ b/device/testing/firmware-xiaomi-polaris/polaris-pulse-setup.service
@@ -0,0 +1,11 @@
+[Unit]
+Description=Polaris PulseAudio setup (load ALSA sink + default)
+After=sound.target
+[Service]
+Type=oneshot
+User=user
+ExecStart=/bin/sh -c 'for i in $(seq 1 300); do [ -e /dev/snd/controlC0 ] && break; sleep 0.2; done; for i in $(seq 1 150); do amixer -c 0 sset "QUAT_MI2S_RX Audio Mixer MultiMedia1" on >/dev/null 2>&1; amixer -c 0 sget "QUAT_MI2S_RX Audio Mixer MultiMedia1" 2>/dev/null | grep -q on && break; sleep 0.5; done; U=$(id -u user); export XDG_RUNTIME_DIR=/run/user/$U; for i in $(seq 1 300); do pactl info >/dev/null 2>&1 && break; sleep 1; done; pactl load-module module-alsa-sink device=hw:0,0 sink_name=polaris_spk rate=48000 >/dev/null 2>&1; sleep 2; pactl suspend-sink polaris_spk 1; sleep 1; pactl suspend-sink polaris_spk 0; sleep 1; pactl set-default-sink polaris_spk; pactl set-sink-volume polaris_spk 100%; pactl set-sink-mute polaris_spk 0'
+Restart=on-failure
+RestartSec=10
+[Install]
+WantedBy=multi-user.target
diff --git a/device/testing/firmware-xiaomi-polaris/polaris-speaker-routing.service b/device/testing/firmware-xiaomi-polaris/polaris-speaker-routing.service
