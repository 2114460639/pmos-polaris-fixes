@@ -0,0 +1,27 @@
+#!/bin/sh
+# Create the XDG user dirs (in English) for every real user.
+#
+# The shipped /etc/skel/.config/user-dirs.conf sets enabled=False, so
+# xdg-user-dirs-update never runs: that keeps the folder names English
+# under zh_CN, but it also means ~/Desktop, ~/Downloads, ... are never
+# created at all (verified on-device).  Enabling the tool instead resets
+# the mappings to $HOME/ when the dirs are missing, so this script is the
+# supported way: build the eight dirs from user-dirs.dirs directly.
+#
+# pmbootstrap creates the default user BEFORE installing packages
+# (pmaports#820), so the home directory already exists when this runs.
+# Idempotent: existing dirs are left alone (owner untouched).
+
+for home in /home/*; do
+	[ -d "$home" ] || continue
+	user=$(basename "$home")
+	uid=$(id -u "$user" 2>/dev/null) || continue
+	gid=$(id -g "$user" 2>/dev/null) || continue
+	for d in Desktop Downloads Templates Public Documents Music Pictures Videos; do
+		if [ ! -d "$home/$d" ]; then
+			mkdir -p "$home/$d" && chown "$uid:$gid" "$home/$d"
+		fi
+	done
+done
+
+exit 0
diff --git a/device/testing/device-xiaomi-polaris/polaris-backlight-rescue b/device/testing/device-xiaomi-polaris/polaris-backlight-rescue
new file mode 100644
index 0000000000..f5e3a9cff4
--- /dev/null
+++ b/device/testing/device-xiaomi-polaris/polaris-backlight-rescue
@@ -0,0 +1,34 @@
+#!/bin/sh
+# Boot brightness rescue for xiaomi-polaris.
+#
+# systemd-backlight restores whatever brightness was saved at the last
+# shutdown; on this device that value has been observed as low as ~1%
+# (40/4095), leaving an unusably dim screen right after boot, and a
+# shutdown with the panel off can even restore 0 (black).  Lift any
+# value below 40% of max_brightness to 40% so every boot starts with a
+# readable screen.  The power key itself keeps its normal behaviour.
+#
+# Polls for a few seconds because the restore unit (systemd-backlight@)
+# is triggered by the backlight device in the sysinit phase and may
+# still be racing us; gives up silently after that.
+
+B=/sys/class/backlight/backlight/brightness
+MAX=/sys/class/backlight/backlight/max_brightness
+
+[ -r "$B" ] || exit 0
+max=$(cat "$MAX" 2>/dev/null)
+[ -n "$max" ] || exit 0
+floor=$((max * 40 / 100))
+
+i=0
+while [ "$i" -lt 15 ]; do
+	b=$(cat "$B" 2>/dev/null)
+	case "$b" in
+		''|*[!0-9]*) exit 0 ;;
+	esac
+	[ "$b" -lt "$floor" ] || exit 0
+	echo "$floor" > "$B" 2>/dev/null
+	i=$((i + 1))
+	sleep 1
+done
+exit 0
diff --git a/device/testing/device-xiaomi-polaris/polaris-backlight-rescue.service b/device/testing/device-xiaomi-polaris/polaris-backlight-rescue.service
new file mode 100644
index 0000000000..709f0f83d5
--- /dev/null
+++ b/device/testing/device-xiaomi-polaris/polaris-backlight-rescue.service
@@ -0,0 +1,15 @@
+[Unit]
+Description=Boot backlight rescue (raise restored brightness below 40%%)
+# systemd-backlight@... restores the saved brightness as soon as the
+# backlight device shows up (sysinit phase, wanted by the device unit);
+# order after it, and the script keeps re-checking for a few seconds in
+# case the restore lands late.
+After=systemd-backlight@backlight:backlight.service
+
+[Service]
+Type=oneshot
+ExecStart=/usr/sbin/polaris-backlight-rescue
+RemainAfterExit=yes
+
+[Install]
+WantedBy=multi-user.target
diff --git a/device/testing/device-xiaomi-polaris/polaris-cpu-snapshot b/device/testing/device-xiaomi-polaris/polaris-cpu-snapshot
new file mode 100644
index 0000000000..c55ff4c3b7
--- /dev/null
+++ b/device/testing/device-xiaomi-polaris/polaris-cpu-snapshot
@@ -0,0 +1,23 @@
+#!/bin/sh
+# Record who eats the CPU, every 30s via polaris-cpu-snapshot.timer.
+#
+# Purpose: hang forensics.  The one time this device hung (RCU starvation)
+# we could not name the culprit because no CPU top was ever captured.  After
+# a hang the last entries in this log point straight at the offender.
+#
+# Uses busybox-compatible `top -b` (procps-style ps --sort is not available
+# in every rootfs) and keeps the log under ~2MB by keeping the newest half.
+
+LOG=/var/log/polaris-cpu.log
+
+{
+	printf '=== %s  load: %s\n' "$(date '+%F %T')" "$(cut -d' ' -f1-3 /proc/loadavg)"
+	top -b -n 1 -d 1 2>/dev/null | head -20
+	echo
+} >>"$LOG" 2>/dev/null
+
+size=$(stat -c%s "$LOG" 2>/dev/null || echo 0)
+if [ "$size" -gt 2097152 ]; then
+	tail -c 1048576 "$LOG" >"$LOG.new" 2>/dev/null && mv "$LOG.new" "$LOG"
+fi
+exit 0
