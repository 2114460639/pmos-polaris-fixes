@@ -62,12 +73,122 @@
 	return container_of(wdd, struct qcom_wdt, wdd);
 }
 
+/*
+ * Selftest hook: writing "1" to /sys/module/qcom_wdt/parameters/wdt_selftest
+ * makes qcom_wdt_ping() a no-op, i.e. simulates a hung PID1 (systemd's pings
+ * arrive but the hardware never gets kicked). Needed because the kernel
+ * silently discards SIGSTOP sent to global init (kernel/signal.c: "SIGKILL
+ * and SIGSTOP may not be sent to the global init"), so userspace cannot
+ * stall feeding the normal way.
+ *
+ * Deliberately does NOT reprogram bark/bite: the goal of the final
+ * verification is the production chain exactly as systemd armed it
+ * (bark=294876 = 9s, bite=327640 = 10s @32764Hz). A failsafe timer
+ * unblocks feeding again after 180s in case the chain fails to fire.
+ */
+static bool wdt_selftest_feed_blocked;
+static struct qcom_wdt *wdt_self;
+
+static void wdt_selftest_dump(const char *tag)
+{
+	int i, j;
+
+	if (!wdt_self)
+		return;
+	for (i = 0; i < 4; i++) {
+		char buf[8 * 9 + 1] = "";
+
+		for (j = 0; j < 8; j++)
+			sprintf(buf + strlen(buf), " %08x",
+				readl(wdt_self->base + (i * 8 + j) * 4));
+		pr_info("qcom-wdt: selftest %s reg[0x%03x..0x%03x]:%s\n",
+			tag, (i * 8) * 4, (i * 8 + 8) * 4 - 4, buf);
+	}
+}
+
+static void wdt_selftest_end(struct timer_list *t)
+{
+	/*
+	 * Failsafe: the bark/bite chain did not kill the box (e.g. the
+	 * counter froze while the SoC idled). Thresholds were never
+	 * touched, so just resume feeding - systemd's next ping lands
+	 * on the still-valid 9s/10s profile.
+	 */
+	WRITE_ONCE(wdt_selftest_feed_blocked, false);
+	wdt_selftest_dump("end  ");
+	pr_info("qcom-wdt: selftest: no bark/bite within 180s of blocked feed, feed resumed\n");
+}
+static DEFINE_TIMER(wdt_selftest_timer, wdt_selftest_end);
+
+static int wdt_selftest_set(const char *val, const struct kernel_param *kp)
+{
+	bool on;
+
+	if (kstrtobool(val, &on))
+		return -EINVAL;
+	if (on) {
+		/*
+		 * Final verification (r43): pure feed-block, no
+		 * reprogramming. r39b/r41/r42 established under load:
+		 *   rate = 32768 Hz (STS view = 65536 Hz);
+		 *   bark is full-width and fires exactly on time at
+		 *     65535 (2.0s), 192000 (5.86s), 294876 (9.0s);
+		 *   bark ISR -> panic_timeout=10 -> panic -> reboot;
+		 *   bite never fires at practical thresholds
+		 *     (65535/131071/192000 all survived their waits
+		 *     with the counter provably running) - so the
+		 *     recovery chain rests on bark alone, and on the
+		 *     stock 9s value systemd armed.
+		 * What remains unproven is the production path itself:
+		 * systemd's own arming + feed blocked + nothing else
+		 * touched -> bark at 9s -> panic -> reboot ~19s.
+		 * Return immediately; timing is measured from the host
+		 * (dmesg stream + ping). Failsafe re-opens the feed at
+		 * 180s if nothing fired (idle-stall case).
+		 */
+		WRITE_ONCE(wdt_selftest_feed_blocked, true);
+		mod_timer(&wdt_selftest_timer, jiffies + 180 * HZ);
+		if (wdt_self)
+			pr_info("qcom-wdt: selftest: feed blocked, armed state en=%08x bark=%08x bite=%08x (expect bark ~9.0s), failsafe 180s\n",
+				readl(wdt_addr(wdt_self, WDT_EN)),
+				readl(wdt_addr(wdt_self, WDT_BARK_TIME)),
+				readl(wdt_addr(wdt_self, WDT_BITE_TIME)));
+		else
+			pr_info("qcom-wdt: selftest: feed blocked (wdt_self unset), failsafe 180s\n");
+	} else {
+		WRITE_ONCE(wdt_selftest_feed_blocked, false);
+		timer_delete_sync(&wdt_selftest_timer);
+	}
+	return 0;
+}
+
+static const struct kernel_param_ops wdt_selftest_ops = {
+	.set = wdt_selftest_set,
+	.get = param_get_bool,
+};
+module_param_cb(wdt_selftest, &wdt_selftest_ops, &wdt_selftest_feed_blocked, 0644);
+
 static irqreturn_t qcom_wdt_isr(int irq, void *arg)
 {
 	struct watchdog_device *wdd = arg;
 
 	watchdog_notify_pretimeout(wdd);
 
+	/*
+	 * bark = pretimeout expired: PID1/userspace stopped feeding the
+	 * watchdog (hard hang). The normal follow-up is a bite, but the bite
+	 * is a FIQ routed to the Qualcomm TEE, which does not run on pmOS -
+	 * nothing drops PS_HOLD and the hardware never resets the machine.
+	 * bark, on the other hand, is a regular GIC interrupt to HLOS.
+	 * Panic here: shrink the panic reboot window first (the sysctl
+	 * default of 120s is for oops diagnosis; a watchdog must be fast),
+	 * then panic - the panic -> reboot path is the reset chain proven to
+	 * work on polaris. Turns the 10s watchdog timeout into real recovery.
+	 */
+	panic_timeout = 10;
+	panic("qcom-wdt: bark, system stopped feeding the watchdog for %us",
+	      wdd->timeout);
+
 	return IRQ_HANDLED;
 }
 
