+		 readl(wdt->base + reg_offset_data_apcs_tmr[WDT_EN]),
+		 readl(wdt->base + reg_offset_data_apcs_tmr[WDT_STS]),
+		 readl(wdt->base + reg_offset_data_apcs_tmr[WDT_BARK_TIME]),
